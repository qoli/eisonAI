NV_PROJECT_NAME=eisonAI
NV_SCRIPT_KIND=versioned-release
NV_AGENT_WRAPPER=/Volumes/Data/Github/callCopilot/bin/callCopilot
NV_ARGS=version,platform,method
NV_ARG_MIN=1
NV_ARG_MAX=3
NV_DEFAULT_PLATFORM=all
NV_DEFAULT_METHOD=release
NV_ALLOWED_PLATFORMS=ios,macos,all
NV_PLATFORM_ALIASES=mac:macos
NV_ALLOWED_METHODS=tf,release
NV_XCODE_PROJECT=eisonAI.xcodeproj
NV_PBXPROJ=eisonAI.xcodeproj/project.pbxproj
NV_SCHEME=iOS
NV_SET_MARKETING_VERSION=true
NV_REQUIRE_CLEAN_WORKTREE=true
NV_FASTLANE_CHANGELOG=fastlane/changelog.txt
NV_TELEGRAM_CHANGELOG=telegram/changelog.md
NV_CHANGELOG_PROMPT_TEMPLATE=prompts/changelog.md.tmpl
NV_RETRY_PROMPT_TEMPLATE=prompts/changelog_retry.md.tmpl
NV_CHANGELOG_SCHEMA=bilingual-version-heading
NV_ACCEPTANCE_AGENT_NAME=translation-validator
NV_ACCEPTANCE_REQUIRED=true
NV_CHANGELOG_MAX_ATTEMPTS=3
NV_COPILOT_RUN_ROOT=logs/new_version_copilot
NV_RELEASE_REF_MODE=python_commit_tag
NV_RELEASE_REF_METHODS=release
NV_FASTLANE_IOS_TF=ios ios_tf
NV_FASTLANE_IOS_RELEASE=ios ios_release
NV_FASTLANE_MACOS_TF=ios mac_tf
NV_FASTLANE_MACOS_RELEASE=ios mac_release
NV_FASTLANE_ALL_TF=ios all_tf
NV_FASTLANE_ALL_RELEASE=ios all_release
